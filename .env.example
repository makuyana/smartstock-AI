# Copy the values from the Meta developer dashboard and your host.
# Leave a line blank only if you do not use that channel yet.

# Meta app → App settings → Basic → App secret
META_APP_SECRET=

# A password you make up. Paste the same words into Meta's webhook "Verify token" box.
WEBHOOK_VERIFY_TOKEN=

# WhatsApp → API setup → temporary or permanent token
WHATSAPP_TOKEN=

# WhatsApp → API setup → Phone number ID
WHATSAPP_PHONE_NUMBER_ID=

# Instagram → generate token
INSTAGRAM_TOKEN=

# Instagram → account id of the shop's professional account
INSTAGRAM_ACCOUNT_ID=

# Host database URL. Render fills this in for you.
DATABASE_URL=

# xAI key for Grok. Leave blank to use the built-in shop-message rules.
# Do not put a real key in this file or in the code. On Render this box stays secret.
LLM_API_KEY=

# OpenAI-compatible base URL. xAI's Grok API is https://api.x.ai/v1
LLM_BASE_URL=https://api.x.ai/v1

# A Grok model name at that provider. grok-4 is a good default. Change it if xAI gives you another name.
LLM_MODEL=grok-4

# Secret for the trusted shop bots (POST/GET /bot/v1). Leave blank to keep that API off.
# Generate one with: openssl rand -hex 32
# Do not put a real value in this file or in the code. On Render this box stays secret.
BOT_API_TOKEN=

# Optional. Defaults are fine.
# GRAPH_API_VERSION=v21.0
# GRAPH_API_BASE_URL=https://graph.facebook.com
# INSTAGRAM_GRAPH_BASE_URL=https://graph.instagram.com
# MEDIA_DIR=/data/media
# SCHEDULER_ENABLED=true
# SEED_DEMO=true
# SCHEDULER_SECRET=
# APP_ENV=production
